# Database (API)
PYTICKETAGENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pyTickets
# PYTICKETAGENT_DATABASE_RETRY_MAX_ATTEMPTS=3
# PYTICKETAGENT_DATABASE_RETRY_INITIAL_DELAY_MS=200
# PYTICKETAGENT_DATABASE_RETRY_MAX_DELAY_MS=2000

# LLM Assist (API)
# PYTICKETAGENT_LLM_PROVIDER=ollama
# PYTICKETAGENT_LLM_MODEL=llama3.2:3b
# PYTICKETAGENT_GROQ_API_KEY=
# PYTICKETAGENT_GEMINI_API_KEY=
# PYTICKETAGENT_LLM_REQUEST_TIMEOUT_SECONDS=120
# PYTICKETAGENT_MAX_OUTPUT_TOKENS=1024
# PYTICKETAGENT_LLM_TRANSIENT_RETRY_MAX_ATTEMPTS=5
# PYTICKETAGENT_LLM_TRANSIENT_RETRY_INITIAL_DELAY_MS=1000
# PYTICKETAGENT_LLM_TRANSIENT_RETRY_MAX_DELAY_MS=60000

# Dual-space embeddings are configured in:
# packages/pyticketagent_core/src/pyticketagent_core/resources/embedding_providers.json
# (spaces.*.model / enabled, requestTimeoutSeconds, defaultSearchSpace — not env vars)
